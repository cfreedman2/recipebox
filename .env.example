# Recipe Box
# Run: npm run dev   (starts the web app AND the recipe-parsing API)

# Required for AI parsing (pasted text + photo reading + food-photo detection).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-from-aistudio.google.com

# Optional — force a specific model (otherwise tries gemini-flash-latest,
# then gemini-2.5-flash, then gemini-2.0-flash):
# GEMINI_MODEL=gemini-flash-latest

# API server port (the Vite dev server proxies /api here):
PORT=3001

# Optional — cloud database (not required; recipes save in the browser by default):
# VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

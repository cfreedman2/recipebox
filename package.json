{
  "name": "recipebox",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"vite --host\" \"node server/index.js\"",
    "dev:web": "vite --host",
    "dev:api": "node server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "preview": "vite preview",
    "install:cloud": "npm install @supabase/supabase-js"
  },
  "dependencies": {
    "@google/genai": "^1.16.0",
    "concurrently": "^9.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^6.2.3"
  }
}

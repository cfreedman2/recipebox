# Recipe Box
# Run: npm run dev   (starts the web app AND the recipe-parsing API)

# Required for AI parsing (pasted text + photo reading + food-photo detection).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyBkE-6iIQtUaErS0aVoDonVqs8xU13WblM

# Optional — force a specific model (otherwise tries gemini-flash-latest,
# then gemini-3.5-flash, then gemini-2.5-flash):
# GEMINI_MODEL=gemini-flash-latest

# API server port (the Vite dev server proxies /api here):
PORT=3001

# ── Accounts + cloud storage (optional) ─────────────────────────────────────
# Without these the app runs in local mode: no sign-in, recipes save in the
# browser. With them, users sign in (Supabase Auth handles password security)
# and recipes are stored per-user in the cloud.
# Setup: create a project at supabase.com, then run supabase/schema.sql in the
# SQL Editor. Keys are under Project Settings → API.
# VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...
# Server-side key — KEEP SECRET, never expose in the browser:
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Payments (optional; requires the Supabase settings above) ───────────────
# Free plan = 30 recipes; the yearly plan removes the limit.
# Setup: create a Product with a YEARLY recurring price at dashboard.stripe.com,
# then add a webhook endpoint for <your-app-url>/api/billing/webhook with events:
# checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted.
# STRIPE_SECRET_KEY=sk_live_... (or sk_test_... while testing)
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Public URL of the deployed app (used for Stripe redirect links):
# APP_URL=https://your-app.example.com
